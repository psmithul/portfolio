{
  "name": "mithul-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app components content lib scripts next.config.ts",
    "format": "oxfmt",
    "predev": "node scripts/content.mjs",
    "prebuild": "node scripts/content.mjs --production",
    "content": "node scripts/content.mjs",
    "post": "node scripts/new-post.mjs",
    "dev:drafts": "JOURNAL_DRAFT_PREVIEW=1 npm run dev",
    "test": "node --test scripts/content.test.mjs scripts/journal.test.ts scripts/journal-session.test.ts scripts/hero-physics.test.ts scripts/reading.test.ts scripts/portfolio-motion.test.ts scripts/portfolio-display.test.ts scripts/suspension-physics.test.ts scripts/journey-timeline.test.ts scripts/journey-choreography.test.ts scripts/journey-scroll-speed.test.ts scripts/journey-mobile.test.ts scripts/journey-clearance.test.ts scripts/voxel-surfaces.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:journal": "node scripts/journal-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.2.12",
    "katex": "^0.18.10",
    "lucide-react": "1.31.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1",
    "unified": "^11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "katex": "$katex",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2"
  }
}
