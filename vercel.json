{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/work", "destination": "/projects", "permanent": true },
    { "source": "/blog", "destination": "/build-log", "permanent": true },
    { "source": "/activities", "destination": "/#activities", "permanent": true },
    { "source": "/work/brain-mri-classification", "destination": "/work/brain-tumour-detection", "permanent": true },
    { "source": "/code/brain-mri-classification.zip", "destination": "/code/brain-tumour-detection.zip", "permanent": true },
    { "source": "/notebooks/Brain_MRI_Classification.ipynb", "destination": "/notebooks/Brain_Tumour_Detection.ipynb", "permanent": true },
    { "source": "/work/neoleg-knee-mechanism", "destination": "/work/kneeassist", "permanent": true },
    { "source": "/work/briskfit", "destination": "/experience/briskfit", "permanent": true },
    { "source": "/work/portfolio-website", "destination": "/projects", "permanent": true },
    { "source": "/work/restia", "destination": "/blog/restia", "permanent": true },
    { "source": "/work/hermes-memory-workspace", "destination": "/blog/hermes-memory-workspace", "permanent": true },
    { "source": "/write/:path*", "destination": "/build-log", "permanent": true },
    { "source": "/v1/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [{ "source": "/health", "destination": "/health.json" }],
  "headers": [
    { "source": "/health", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
